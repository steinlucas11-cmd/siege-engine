# fly.toml
app = "sua-app"
primary_region = "gru"

[machines]
  min_machines_running = 1
  max_machines_running = 1

[[services]]
  internal_port = 8080
  protocol = "tcp"

    [[services.http_checks]]
      interval = "10s"
      timeout = "2s"
      method = "GET"
      path = "/health"
      headers = { "Host" = "sua-app.fly.dev" }

[[machine]]
  image = "seu-image:tag"
  cmd = ["/bin/sh", "-c", "seu-comando-inicial"]
