# fly.toml
app = "siege-engine-master"
primary_region = "gru" # Choose a region close to you (e.g., Sao Paulo)

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = false # CRITICAL: Prevents auto-stop
  auto_start_machines = true
  min_machines_running = 1
  max_machines_running = 1

[[vm]]
  size = "shared-c1x2" # 1 vCPU, 2GB RAM (Enough for Python + Flask)
